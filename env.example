# Every setting, with its default. ./setup.sh writes .env for you; copy this
# file over it instead if you would rather fill it in by hand.

# InfoMentor login. Use the username and password, not e-legitimation:
# the digest runs unattended and cannot answer a BankID prompt.
INFOMENTOR_USERNAME=
INFOMENTOR_PASSWORD=

# Telegram. Create a bot with @BotFather. The chat id belongs to whoever wrote
# to the bot; ./setup.sh reads it for you, or take it yourself
# from https://api.telegram.org/bot<TOKEN>/getUpdates. A group id is negative.
# To reach two parents, put the bot in a group and send /start there: in a group
# a bot only sees commands.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Mail. The relay must accept mail without a login.
SMTP_HOST=
SMTP_PORT=25
MAIL_FROM=
MAIL_TO=

# When to report, in Swedish time. One time, or a comma-separated list.
RUN_AT=18:30

# How far ahead calendar events are read.
DAYS_AHEAD=21

# Where the reported keys live, beside the checkout by default.
DATA_DIR=data

# Set to 1 to watch the browser work. It needs a screen, so keep it 0 on a server.
HEADED=0
